{
  "name": "solana-ia-ideathon-open-toolkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.18.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "npm run build && node apps/ideathon/dist/index.js",
    "start": "node apps/ideathon/dist/index.js",
    "test": "npm run build && node --test --experimental-strip-types apps/ideathon/test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.0"
  }
}
